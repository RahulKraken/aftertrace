/data/
# Vite writes web/dist. Stub index.html is tracked so go:embed compiles
# without Node. Built assets stay untracked and are embedded from disk.
web/dist/**
!web/dist/index.html

# Local Claude Code state (launch config, worktrees)
/.claude/

# Desktop (Electron) local install and packs. The Go sidecar is copied in
# before packaging; it is not committed.
desktop/node_modules/
desktop/dist/
desktop/resources/engine/aftertrace
desktop/resources/engine/aftertrace.exe

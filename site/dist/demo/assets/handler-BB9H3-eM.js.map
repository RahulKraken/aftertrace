{"answer":"pdf-report costs the most: $6.483 per activation, $6.483 over 16 requests and 1 activation(s).","sql":"SELECT l.skill_name, round(sum(l.cost_usd),3) AS cost_usd, count(*) AS requests,\n  (SELECT count(*) FROM events e WHERE e.name='skill_activated' AND a(e.attrs,'skill.name')=l.skill_name) AS activations,\n  round(sum(l.cost_usd) / greatest(1,(SELECT count(*) FROM events e WHERE e.name='skill_activated' AND a(e.attrs,'skill.name')=l.skill_name)),3) AS usd_per_activation\nFROM llm l WHERE l.skill_name IS NOT NULL GROUP BY l.skill_name ORDER BY usd_per_activation DESC","result":{"columns":["skill_name","cost_usd","requests","activations","usd_per_activation"],"rows":[["pdf-report",6.483,16,1,6.483],["frontend-design",0.757,20,1,0.757]]},"evidence":[{"trace_id":"56935464abc32f23ae55ecfde6a9a802","span_id":"16467e1d5cb2aac5","label":"pdf-report $0.756"},{"trace_id":"13ea6b7ffbf02776a3976e89efd1f499","span_id":"5f4bb7e094f86d8c","label":"pdf-report $0.717"},{"trace_id":"a70cfc52eef44014529931675d68743d","span_id":"56ead151dacdae7e","label":"pdf-report $0.516"},{"trace_id":"13ea6b7ffbf02776a3976e89efd1f499","span_id":"d69269da529adc3b","label":"pdf-report $0.516"},{"trace_id":"13ea6b7ffbf02776a3976e89efd1f499","span_id":"18ebb214eb95c697","label":"pdf-report $0.421"}],"builder":{"agg":"SUM","field":"cost_usd","where":[{"field":"name","op":"=","value":"claude_code.llm_request"}],"group_by":["skill.name"],"order":"desc","limit":20}}
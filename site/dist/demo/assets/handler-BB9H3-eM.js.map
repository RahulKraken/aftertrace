{"answer":"Retries cost 212.2s on claude-sonnet-5 across 7 requests (22 failed attempts). Time is measured to the start of the last attempt (inferred).","sql":"SELECT l.model, count(*) AS retried_requests, sum(l.attempt - 1) AS failed_attempts,\n  round(sum((e.last_attempt_ns - l.start_ns)/1e9),1) AS seconds_lost\nFROM llm l JOIN (SELECT trace_id, span_id, max(time_ns) AS last_attempt_ns FROM span_events WHERE name='gen_ai.request.attempt' GROUP BY 1,2) e\n  USING (trace_id, span_id)\nWHERE l.attempt > 1 GROUP BY l.model ORDER BY seconds_lost DESC","result":{"columns":["model","retried_requests","failed_attempts","seconds_lost"],"rows":[["claude-sonnet-5",7,22.0,212.2]]},"evidence":[{"trace_id":"b72cc2de8b97cc7980e4893460cf4c48","span_id":"4ff0ee0645ff911a","label":"claude-sonnet-5 x11.0"},{"trace_id":"80710f3727d0ccbf8e52d76e529a0442","span_id":"b63093b58ede0777","label":"claude-sonnet-5 x2.0"},{"trace_id":"b72cc2de8b97cc7980e4893460cf4c48","span_id":"b5f10127ed398fe3","label":"claude-sonnet-5 x2.0"},{"trace_id":"b72cc2de8b97cc7980e4893460cf4c48","span_id":"a7efb5a912e03e64","label":"claude-sonnet-5 x3.0"},{"trace_id":"80710f3727d0ccbf8e52d76e529a0442","span_id":"db2fd0fe06a7f0e8","label":"claude-sonnet-5 x5.0"},{"trace_id":"aa31efeff01ba94e8e4512fadb8ee2f2","span_id":"cda1b5546dac3562","label":"claude-sonnet-5 x4.0"}],"builder":{"agg":"SUM","field":"duration_ms","where":[{"field":"attempt","op":">","value":"1"}],"group_by":["model"],"order":"desc","limit":20}}